# ---------------------------------------------------------------------------
# Data — all of it. Every byte is reproducible with scripts/00_download_data.py,
# and the raw downloads run to well over a gigabyte. data/_manifest.json records
# the URL, size, SHA256 and retrieval time of every file, so a specific run
# stays reproducible without committing the data itself.
# ---------------------------------------------------------------------------
data/**

# ---------------------------------------------------------------------------
# Local-only working notes. Kept on disk for reference, deliberately NOT
# published. See notes/README.md for what lives here.
# ---------------------------------------------------------------------------
notes/**

# ---------------------------------------------------------------------------
# macOS / Windows / Linux desktop cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments
.venv/
venv/
ENV/
env/
.conda/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Testing / coverage / type checking
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ---------------------------------------------------------------------------
# Secrets — never commit credentials. API keys belong in a local .env that is
# read at runtime, not in source. See notes/CREDENTIALS.md.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json
census_api_key.txt

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# ---------------------------------------------------------------------------
# Scratch and transient output
# ---------------------------------------------------------------------------
scratch/
tmp/
*.log
*.tmp
*.bak

# Word/LibreOffice lock and autosave files
~$*.docx
~$*.pptx
~$*.xlsx
.~lock.*#
